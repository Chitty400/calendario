{
  "redirects": [
    { "source": "/calendario.html", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "destination": "/landing.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/:slug([a-z0-9-]+)", "destination": "/calendario.html" },
    { "source": "/:slug([a-z0-9-]+)/", "destination": "/calendario.html" }
  ],
  "headers": [
    {
      "source": "/admin(.html)?",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}